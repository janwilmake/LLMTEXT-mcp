{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "feed-crawler",
  "main": "worker.ts",
  "compatibility_date": "2025-07-14",
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "routes": [{ "custom_domain": true, "pattern": "rss.llmtext.com" }],
  "durable_objects": {
    "bindings": [
      {
        "name": "FEEDCRAWLER",
        "class_name": "FeedCrawler"
      },
      {
        "name": "FEEDFETCHER",
        "class_name": "FeedFetcher"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FeedCrawler"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["FeedFetcher"]
    }
  ]
}
